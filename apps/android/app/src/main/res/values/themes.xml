<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose paints the whole window, so this only has to survive until it does. It has
      to be an AppCompat theme all the same: the per-app language switch runs through
      AppCompatDelegate, which needs an AppCompat host on Android 12 and below.
    -->
    <style name="Theme.Bill" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
