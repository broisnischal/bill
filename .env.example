VITE_BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:password@localhost:5455/bill"
# docker compose up -d  brings up Postgres (5455) and MinIO (9002, console 9003)

# bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Object storage for archived invoice PDFs (MinIO locally, S3-compatible in production)
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=bill-invoices
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# IRD Central Billing Monitoring System
# Sandbox: https://cbapitest.ird.gov.np/api/bill
IRD_CBMS_BILL_URL=https://cbapi.ird.gov.np/api/bill
IRD_CBMS_BILL_RETURN_URL=https://cbapi.ird.gov.np/api/billreturn

# OAuth2 providers, optional
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development defaults
# Leave SPARROW_SMS_TOKEN blank and the OTP is never sent: it is logged and served to the
# app by GET /api/v1/dev/otp, which only answers when there is no gateway configured.
# Leave IRD_CBMS_LIVE false and bills are marked synced without a request to the IRD.
IRD_CBMS_LIVE=false
