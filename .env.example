VITE_BASE_URL=http://localhost:3000
# A production build reads .env.production instead, which carries the deployed origin.

# Nothing to bring up: `bun run dev` runs the Worker locally and wrangler creates the
# D1 database and the R2 bucket on disk under .wrangler on first use.

# bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Archived PDFs and uploaded business papers go to the R2 bucket bound as ARCHIVE in
# wrangler.jsonc. The binding is the whole client: no endpoint, no region, no key pair.

# IRD Central Billing Monitoring System
# Sandbox: https://cbapitest.ird.gov.np/api/bill
IRD_CBMS_BILL_URL=https://cbapi.ird.gov.np/api/bill
IRD_CBMS_BILL_RETURN_URL=https://cbapi.ird.gov.np/api/billreturn

# OAuth2 providers, optional
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development defaults
# With no OPENWA_* and no SPARROW_SMS_TOKEN nothing is sent: the OTP is logged and served
# to the app by GET /api/v1/dev/otp, which answers only for the numbers below.
# Leave IRD_CBMS_LIVE false and bills are marked synced without a request to the IRD.
IRD_CBMS_LIVE=false

# Who may review businesses at /admin, as mobile numbers in E.164, comma separated.
# Empty means nobody, and a deployment with nobody cannot approve anyone.
ADMIN_PHONES=

# Whose code /api/v1/dev/otp hands back, comma separated, E.164. Empty means nobody.
# A readable code is a way to sign in as whoever the number belongs to, so this is a
# named list and never everybody.
OTP_DEBUG_PHONES=
OTP_DEBUG=false

# WhatsApp, which is what a code actually goes out on. An OpenWA server: the base URL,
# an API key, and the id of the session whose linked account does the sending. All three
# are needed before anything is sent, and a missing one skips WhatsApp rather than
# failing the sign-in. See src/lib/sms/openwa.ts.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
